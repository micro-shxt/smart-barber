# Public Vite configuration. Values may be bundled into client applications.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side and trusted-build configuration only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_JWT_SECRET=

# Optional deployment configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Smart Barber local backend (not browser-exposed)
PORT=3001
MOCK_AUTH_ENABLED=true
